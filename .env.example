# ─── TaskFlow backend environment (Spring Boot + MySQL) ──────────────────────
# Copy to .env (or export these variables) before running the backend.
# The frontend does NOT read this file — its API/WebSocket URLs live in frontend/src/config.js
# and can be overridden with VITE_API_BASE_URL / VITE_WS_URL.

# Server
APP_ENV=development
SERVER_PORT=8080

# ─── MySQL ───────────────────────────────────────────────────────────────────
# Create the database first:  CREATE DATABASE taskflow;
DB_HOST=localhost
DB_PORT=3306
DB_NAME=taskflow
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Hibernate schema management: update | validate | create | create-drop
DDL_AUTO=update
SHOW_SQL=false

# ─── JWT (use long random values in production) ──────────────────────────────
JWT_SECRET=your_jwt_secret_here_make_it_long_and_random
JWT_REFRESH_SECRET=your_refresh_secret_here_make_it_long_and_random
# Access token TTL in milliseconds (default 15 minutes)
JWT_EXPIRES_IN=900000
# Refresh token TTL in milliseconds (default 7 days)
JWT_REFRESH_EXPIRES_IN=604800000

# ─── CORS (comma-separated list of allowed frontend origins) ─────────────────
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost

# ─── Uploads ─────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads

# ─── Optional demo data (recreates the original `npm run seed` dataset) ──────
APP_SEED_ENABLED=false
